<?xml version="1.0" ?>
<robot name="box_robot">

  <!-- Jediná linka, představuje celou krabici -->
  <link name="box_link">
    <!-- Vizuální reprezentace -->
    <visual>
      <geometry>
        <mesh filename="box.stl" scale="1 1 1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.7 0.7 0.7 0.3"/>
      </material>
    </visual>

    <!-- Kolizní geometrie -->
    <collision>
      <geometry>
        <mesh filename="box.stl" scale="1 1 1"/>
      </geometry>
    </collision>

    <!-- Inertní vlastnosti (můžeš upravit hmotnost a tvar) -->
    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.1" ixy="0.0" ixz="0.0"
        iyy="0.1" iyz="0.0"
        izz="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
  </link>

</robot>
