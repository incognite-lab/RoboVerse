<mujoco model="glass_box">

  <worldbody>
    <!-- Statická krabice -->
    <body name="glass_box" pos="0 0 0">
      
      <!-- Vizuální geometrie -->
      <geom type="mesh"
            mesh="box_mesh" 
            material="glass_mat" 
            contype="1" conaffinity="1" 
            condim="3"/>

    </body>
  </worldbody>

  <!-- Definice materiálu -->
  <asset>
    <mesh name="box_mesh" file="box.stl" scale="1 1 1"/>
    <material name="glass_mat" rgba="0.7 0.9 1.0 0.3"/>
  </asset>

</mujoco>

