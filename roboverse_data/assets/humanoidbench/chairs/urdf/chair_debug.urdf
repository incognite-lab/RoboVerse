  <joint name="floor_slide_y" type="prismatic">
    <parent link="slide_link_x" />
    <child link="slide_link_y" />
    <origin rpy="0 0 0" xyz="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="1000" lower="-10.0" upper="10.0" velocity="5.0" />
    <dynamics damping="10.0" friction="5.0" />
  </joint>

  <joint name="base_to_leg_1" type="fixed">
    <parent link="base_link" />
    <child link="leg_1" />
    <origin rpy="0 0 0" xyz="0 0 0" />
  </joint>

  <joint name="base_to_leg_2" type="fixed">
    <parent link="base_link" />
    <child link="leg_2" />
