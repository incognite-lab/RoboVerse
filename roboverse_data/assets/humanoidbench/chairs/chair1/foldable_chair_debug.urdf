  </joint>

  <link name="debug_com">
    <!-- <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.05" /></geometry>
      <material name="m_debug_com"><color rgba="0 0 1 1" /></material>
    </visual> -->
  </link>
  <joint name="j_debug_com" type="fixed">
    <parent link="base_link" />
    <child link="debug_com" />
    <origin xyz="1.2356480307692006e-17 0.04918193924989267 0.5275596101737766" rpy="0 0 0" />
  </joint>

  <link name="debug_vec">
    <!-- <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.01" length="0.5" /></geometry>
      <material name="m_debug_vec"><color rgba="0 0 1 0.5" /></material>
    </visual> -->
  </link>
  <joint name="j_debug_vec" type="fixed">
    <parent link="base_link" />
    <child link="debug_vec" />
    <origin xyz="1.2356480307692006e-17 0.04918193924989267 0.7775596101737766" rpy="0 0 0" />
  </joint>

  <link name="debug_foot_0">
    <!-- <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.04" /></geometry>
      <material name="m_debug_foot_0"><color rgba="0 1 0 1" /></material>
    </visual> -->
  </link>
  <joint name="j_debug_foot_0" type="fixed">
    <parent link="base_link" />
    <child link="debug_foot_0" />
    <origin xyz="-0.299405804225286 -0.22087093938440658 0.0" rpy="0 0 0" />
  </joint>

  <link name="debug_foot_1">
    <!-- <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.04" /></geometry>
      <material name="m_debug_foot_1"><color rgba="0 1 0 1" /></material>
    </visual> -->
  </link>
  <joint name="j_debug_foot_1" type="fixed">
    <parent link="base_link" />
    <child link="debug_foot_1" />
    <origin xyz="-0.29914276140104434 0.3832650628893974 0.000839614003599516" rpy="0 0 0" />
