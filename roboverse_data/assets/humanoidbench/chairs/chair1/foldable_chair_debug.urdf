  </joint>

  <link name="debug_foot_3">
    <!-- <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.04" /></geometry>
      <material name="m_debug_foot_3"><color rgba="0 1 0 1" /></material>
