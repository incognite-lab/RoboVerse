<?xml version="1.0"?>
<robot name="foldable_chair_gen">

  <link name="link_2">
    <inertial>
      <mass value="1.0" /> <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
    <!-- <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="anchor_red"><color rgba="1 0 0 1"/></material>
    </visual> -->
  </link>

  <link name="slide_link_x">
    <inertial>
      <mass value="0.01" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>

  <link name="slide_link_y">
    <inertial>
      <mass value="0.01" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>


  <joint name="floor_slide_x" type="prismatic">
    <parent link="link_2" />
    <child link="slide_link_x" />
    <axis xyz="1 0 0" />
    <limit lower="-10.0" upper="10.0" effort="1000.0" velocity="5.0" />
    <dynamics damping="10.0" friction="1.0" />
  </joint>

  <joint name="floor_slide_y" type="prismatic">
    <parent link="slide_link_x" />
    <child link="slide_link_y" />
    <axis xyz="0 1 0" />
    <limit lower="-10.0" upper="10.0" effort="1000.0" velocity="5.0" />
    <dynamics damping="10.0" friction="1.0" />
  </joint>

  <joint name="floor_rotate_z" type="continuous">
    <parent link="slide_link_y" />
    <child link="base_link" />
    <axis xyz="0 0 1" />
    <dynamics damping="10.0" friction="1.0" />
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0006832693307789943" rpy="1.5708 0 0" />
      <geometry>
        <mesh filename="mesh/foldable_chair.stl" scale="0.02 0.02 0.02" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.0006832693307789943" rpy="1.5708 0 0" />
      <geometry>
        <mesh filename="mesh/foldable_chair.stl" scale="0.02 0.02 0.02" />
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0" />
      <origin xyz="1.2356480307692006e-17 0.04918193924989267 0.5275596101737766" />
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
    </inertial>
  </link>

  <link name="debug_top_center">
    <!-- <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.04" /></geometry>
      <material name="m_debug_top_center"><color rgba="1 0 0 1" /></material>
    </visual> -->
  </link>
  <joint name="j_debug_top_center" type="fixed">
    <parent link="base_link" />
    <child link="debug_top_center" />
    <origin xyz="0.0 0.29020362379482156 0.9632205982065832" rpy="0 0 0" />
  </joint>

  <link name="target_hand_left">
    <!-- <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.03" /></geometry>
      <material name="m_target_hand_left"><color rgba="1 1 0 1" /></material>
    </visual> -->
  </link>
  <joint name="j_target_hand_left" type="fixed">
    <parent link="base_link" />
    <child link="target_hand_left" />
    <origin xyz="0.15 0.29020362379482156 0.9632205982065832" rpy="0 0 -1.5708" />
  </joint>

  <link name="target_hand_right">
    <!-- <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.03" /></geometry>
      <material name="m_target_hand_right"><color rgba="1 1 0 1" /></material>
    </visual> -->
  </link>
  <joint name="j_target_hand_right" type="fixed">
    <parent link="base_link" />
    <child link="target_hand_right" />
