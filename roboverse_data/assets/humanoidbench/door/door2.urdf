<?xml version="1.0"?>
<robot name="wall_with_single_door">
  <!-- WALL AND DOOR AS BEFORE -->

  <link name="wall_base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <!-- LEFT PANEL -->
  <link name="wall_left">
    <visual>
      <origin xyz="-1.5 0 1.5" />
      <geometry>
        <box size="2.0 0.05 3.0" />
      </geometry>
      <material name="grey"><color rgba="0.7 0.7 0.7 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="-1.5 0 1.5" />
      <geometry>
        <box size="2.0 0.05 3.0" />
      </geometry>
    </collision>
  </link>

  <joint name="wall_left_fixed" type="fixed">
    <parent link="wall_base"/>
    <child  link="wall_left"/>
  </joint>

  <!-- RIGHT PANEL -->
  <link name="wall_right">
    <visual>
      <origin xyz="1.5 0 1.5" />
      <geometry>
        <box size="2.0 0.05 3.0" />
      </geometry>
      <material name="grey"><color rgba="0.7 0.7 0.7 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="1.5 0 1.5" />
      <geometry>
        <box size="2.0 0.05 3.0" />
      </geometry>
    </collision>
  </link>

  <joint name="wall_right_fixed" type="fixed">
    <parent link="wall_base"/>
    <child  link="wall_right"/>
  </joint>

  <!-- LINTEL -->
  <link name="wall_lintel">
    <visual>
      <origin xyz="0 0 2.55" />
      <geometry>
        <box size="5.0 0.05 0.9" />
      </geometry>
      <material name="grey"><color rgba="0.7 0.7 0.7 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 2.55" />
      <geometry>
        <box size="5.0 0.05 0.9" />
      </geometry>
    </collision>
  </link>

  <joint name="wall_lintel_fixed" type="fixed">
    <parent link="wall_base"/>
    <child  link="wall_lintel"/>
  </joint>

  <!-- DOOR -->
  <link name="door">
    <visual>
      <origin xyz="0.5 0 1.05" />
      <geometry>
        <box size="1.0 0.05 2.1" />
      </geometry>
      <material name="wood"><color rgba="0.65 0.45 0.2 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0.5 0 1.05" />
      <geometry>
        <box size="1.0 0.05 2.1" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.5 0 1.05" />
      <mass value="1.0" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
    </inertial>
  </link>

  <joint name="door_hinge" type="revolute">
    <parent link="wall_base" />
    <child  link="door" />
    <origin xyz="-0.5 0 0.0" />
    <axis xyz="0 0 1" />
    <limit effort="1.0" velocity="5.0" lower="-1.5708" upper="1.5708" />
    <dynamics damping="0.5" friction="0.0" />
  </joint>

  <!-- ✅ FIXED DOOR HANDLE (L-shaped) -->
  <link name="door_handle">
    <!-- tvoří tvar písmene L-->
    <visual>
      <!-- horizontální část (trubka směrem ven) -->
      <origin xyz="0.9 0.075 1.05" rpy="0 0 0" />
      <geometry>
        <box size="0.1 0.02 0.02" />
      </geometry>
      <material name="metal"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>

    <visual>
      <!-- svislá část (nahoru dolů) -->
      <origin xyz="0.95 0.035 1.05" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.1 0.02" />
      </geometry>
      <material name="metal"/>
    </visual>

    <collision>
      <origin xyz="1.0 0.075 1.14" />
      <geometry>
        <box size="0.2 0.02 0.2" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <!-- Klika připojená pevně k dveřím -->
  <joint name="door_handle_fixed" type="fixed">
    <parent link="door"/>
    <child link="door_handle"/>
    <origin xyz="0 0 0" />
  </joint>

</robot>
