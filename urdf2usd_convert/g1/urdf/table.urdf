<?xml version="1.0"?>
<robot name="table">

  <!-- Table top -->
  <link name="table_top">
    <visual>
      <geometry>
        <box size="1 1 0.05"/>
      </geometry>
      <origin xyz="0 0 0.725" rpy="0 0 0"/>
      <material name="brown"/>
    </visual>
    <collision>
      <geometry>
        <box size="1 1 0.05"/>
      </geometry>
      <origin xyz="0 0 0.725" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      <origin xyz="0 0 0.725" rpy="0 0 0"/>
    </inertial>
  </link>

  <!-- Four legs -->
  <link name="leg_fl"> <!-- front-left -->
    <visual>
      <geometry>
        <box size="0.1 0.1 0.7"/>
      </geometry>
      <origin xyz="-0.45 -0.45 0.35" rpy="0 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.7"/>
      </geometry>
      <origin xyz="-0.45 -0.45 0.35" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      <origin xyz="-0.45 -0.45 0.35" rpy="0 0 0"/>
    </inertial>
  </link>

  <link name="leg_fr"> <!-- front-right -->
    <visual>
      <geometry>
        <box size="0.1 0.1 0.7"/>
      </geometry>
      <origin xyz="0.45 -0.45 0.35" rpy="0 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.7"/>
      </geometry>
      <origin xyz="0.45 -0.45 0.35" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      <origin xyz="0.45 -0.45 0.35" rpy="0 0 0"/>
    </inertial>
  </link>

  <link name="leg_bl"> <!-- back-left -->
    <visual>
      <geometry>
        <box size="0.1 0.1 0.7"/>
      </geometry>
      <origin xyz="-0.45 0.45 0.35" rpy="0 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.7"/>
      </geometry>
      <origin xyz="-0.45 0.45 0.35" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      <origin xyz="-0.45 0.45 0.35" rpy="0 0 0"/>
    </inertial>
  </link>

  <link name="leg_br"> <!-- back-right -->
    <visual>
      <geometry>
        <box size="0.1 0.1 0.7"/>
      </geometry>
      <origin xyz="0.45 0.45 0.35" rpy="0 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.7"/>
      </geometry>
      <origin xyz="0.45 0.45 0.35" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      <origin xyz="0.45 0.45 0.35" rpy="0 0 0"/>
    </inertial>
  </link>

  <!-- Fixed joints connecting legs to table top -->
  <joint name="joint_fl" type="fixed">
    <parent link="table_top"/>
    <child link="leg_fl"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="joint_fr" type="fixed">
    <parent link="table_top"/>
    <child link="leg_fr"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="joint_bl" type="fixed">
    <parent link="table_top"/>
    <child link="leg_bl"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="joint_br" type="fixed">
    <parent link="table_top"/>
    <child link="leg_br"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>

