<?xml version="1.0" ?>
<robot name="office_chair">

  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="chrome">
    <color rgba="0.8 0.8 0.9 1"/>
  </material>
  <material name="red_target">
    <color rgba="1.0 0.0 0.0 1"/>
  </material>

  <link name="world"/>

  <link name="slide_link_x">
    <inertial>
        <mass value="0.01"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="floor_slide_x" type="prismatic">
    <parent link="world"/>
    <child link="slide_link_x"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="-10.0" upper="10.0" velocity="5.0"/>
    <dynamics damping="10.0" friction="5.0"/>
  </joint>

  <link name="slide_link_y">
     <inertial>
        <mass value="0.01"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="floor_slide_y" type="prismatic">
    <parent link="slide_link_x"/>
    <child link="slide_link_y"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-10.0" upper="10.0" velocity="5.0"/>
    <dynamics damping="10.0" friction="5.0"/>
  </joint>

  <joint name="floor_rotate_z" type="continuous">
    <parent link="slide_link_y"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>


  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.08"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <link name="leg_1">
    <visual>
      <origin rpy="0 0 0" xyz="0.175 0 0"/>
      <geometry>
        <box size="0.35 0.04 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0.35 0 -0.05"/>
      <geometry>
        <cylinder length="0.04" radius="0.03"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.175 0 -0.02"/>
      <geometry>
         <box size="0.35 0.05 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="base_to_leg_1" type="fixed">
    <parent link="base_link"/>
    <child link="leg_1"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <link name="leg_2">
    <visual>
      <origin rpy="0 0 0" xyz="0.175 0 0"/>
      <geometry>
        <box size="0.35 0.04 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0.35 0 -0.05"/>
      <geometry>
        <cylinder length="0.04" radius="0.03"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.175 0 -0.02"/>
      <geometry>
         <box size="0.35 0.05 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="base_to_leg_2" type="fixed">
    <parent link="base_link"/>
    <child link="leg_2"/>
    <origin rpy="0 0 1.2566" xyz="0 0 0"/>
  </joint>

  <link name="leg_3">
    <visual>
      <origin rpy="0 0 0" xyz="0.175 0 0"/>
      <geometry>
        <box size="0.35 0.04 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0.35 0 -0.05"/>
      <geometry>
        <cylinder length="0.04" radius="0.03"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.175 0 -0.02"/>
      <geometry>
         <box size="0.35 0.05 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="base_to_leg_3" type="fixed">
    <parent link="base_link"/>
    <child link="leg_3"/>
    <origin rpy="0 0 2.5132" xyz="0 0 0"/>
  </joint>

  <link name="leg_4">
    <visual>
      <origin rpy="0 0 0" xyz="0.175 0 0"/>
      <geometry>
        <box size="0.35 0.04 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0.35 0 -0.05"/>
      <geometry>
        <cylinder length="0.04" radius="0.03"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.175 0 -0.02"/>
      <geometry>
         <box size="0.35 0.05 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="base_to_leg_4" type="fixed">
    <parent link="base_link"/>
    <child link="leg_4"/>
    <origin rpy="0 0 3.7699" xyz="0 0 0"/>
  </joint>

  <link name="leg_5">
    <visual>
      <origin rpy="0 0 0" xyz="0.175 0 0"/>
      <geometry>
        <box size="0.35 0.04 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0.35 0 -0.05"/>
      <geometry>
        <cylinder length="0.04" radius="0.03"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.175 0 -0.02"/>
      <geometry>
         <box size="0.35 0.05 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="base_to_leg_5" type="fixed">
    <parent link="base_link"/>
    <child link="leg_5"/>
    <origin rpy="0 0 5.0265" xyz="0 0 0"/>
  </joint>

  <link name="rod_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.15"/>
      <geometry>
        <cylinder length="0.3" radius="0.04"/>
      </geometry>
      <material name="chrome"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.15"/>
      <geometry>
        <cylinder length="0.3" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <joint name="seat_swivel" type="continuous">
    <parent link="base_link"/>
    <child link="rod_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <link name="seat_surface_link">
    <visual>
      <geometry>
        <box size="0.45 0.45 0.05"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.45 0.45 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <joint name="rod_to_seat" type="fixed">
    <parent link="rod_link"/>
    <child link="seat_surface_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.3"/>
  </joint>

  <link name="backrest_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.25"/>
      <geometry>
        <box size="0.05 0.45 0.5"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.25"/>
      <geometry>
        <box size="0.05 0.45 0.5"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <joint name="seat_to_backrest" type="fixed">
    <parent link="seat_surface_link"/>
    <child link="backrest_link"/>
    <origin rpy="0 0 0" xyz="-0.2 0 0.025"/>
  </joint>

  <link name="handle_link">
    <visual>
      <geometry>
        <cylinder length="0.5" radius="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.5" radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="backrest_to_handle" type="fixed">
    <parent link="backrest_link"/>
    <child link="handle_link"/>
    <origin rpy="1.5708 0 0" xyz="0 0 0.5"/>
  </joint>

  <link name="target_left_link">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="red_target"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="handle_to_target_left" type="fixed">
    <parent link="handle_link"/>
    <child link="target_left_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.2"/>
  </joint>

  <link name="target_right_link">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="red_target"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="handle_to_target_right" type="fixed">
    <parent link="handle_link"/>
    <child link="target_right_link"/>
    <origin rpy="0 0 0" xyz="0 0 -0.2"/>
  </joint>

</robot>

